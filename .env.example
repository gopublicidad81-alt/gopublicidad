# Copia este archivo a .env.local y rellena con tus valores.
# En Vercel: agrega estas mismas variables en Project → Settings → Environment Variables.
# (NO subas .env.local a git — ya está en .gitignore.)

# --- Supabase ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_SERVICE_ROLE=tu-service-role-key

# --- Acceso (login del panel) ---
AUTH_EMAIL=correo@dominio.com
# Opción A (local): clave en texto plano.
AUTH_PASSWORD=tu-clave
# Opción B (recomendada en Coolify/Docker si la clave tiene $ u otros símbolos):
# hash SHA-256 en hex de la clave (no lo interpolan). Si está, tiene prioridad.
# Genera el hash con:
#   node -e "console.log(require('crypto').createHash('sha256').update('TU_CLAVE').digest('hex'))"
# AUTH_PASSWORD_HASH=
# Secreto para firmar la sesión. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# --- URL pública de la app (para links en correos) ---
APP_URL=http://localhost:3000

# ── Avisos por correo (asignación de vendedor + lead nuevo) ──
# Gmail SMTP con contraseña de aplicación (2FA activada en la cuenta):
# myaccount.google.com → Seguridad → Verificación en 2 pasos → Contraseñas de aplicación
GMAIL_USER=gopublicidad81@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
MAIL_FROM=Ecostand CRM <gopublicidad81@gmail.com>
# Destinatarios del aviso de lead nuevo (separados por coma)
LEADS_NOTIFICAR_A=nicolas@go-publicidad.cl,gopublicidad81@gmail.com
# Secreto que debe enviar el Database Webhook de Supabase en el header x-webhook-secret
LEADS_WEBHOOK_SECRET=cambia-esto-por-una-frase-larga
# URL pública del CRM (para el botón "Abrir en el CRM" de los correos)
APP_URL=https://tu-crm.coolify.dominio
